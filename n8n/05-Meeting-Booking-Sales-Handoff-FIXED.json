    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $json || {};\nconst summary = job.workflow05_summary || {};\nconst warning = Number(summary.human_review_queue || 0) > 0;\nlet stage = 'lead_generation_completed';\nif (Number(summary.meetings_booked || 0) > 0) stage = 'meeting_booked_sales_handoff_completed';\nelse if (Number(summary.sales_handoffs_completed || 0) > 0) stage = 'sales_handoff_completed';\nelse if (warning) stage = 'completed_with_human_review';\nreturn { json: {\n  ...job, final_job_stage: stage, final_job_severity: warning ? 'warning' : 'info',\n  final_job_message: warning\n    ? `Lead generation completed with ${summary.human_review_queue || 0} item(s) requiring human review.`\n    : 'Lead generation, outreach monitoring, and sales handoff completed.'\n} };"
      },
