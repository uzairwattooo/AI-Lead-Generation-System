        "jsCode": "const job = $('Get Workflow 05 Job').first().json || {};\nconst leads = $input.all().map((item) => item.json || {});\nconst targets = leads.filter((lead) => lead.outreach_id || lead.gmail_thread_id || [\n  'reply_needs_human','meeting_requested','meeting_processing','awaiting_meeting_selection',\n  'report_requested','report_shared','awaiting_booking','meeting_booked','meeting_needs_human','sales_handoff_completed','sales_handoff_failed'\n].includes(String(lead.status || '')));\nconst alwaysActiveStatuses = new Set(['awaiting_reply','follow_up_preparing','report_requested','meeting_requested','meeting_processing','awaiting_meeting_selection','awaiting_booking']);\nconst isActive = (lead) => {\n  const status = String(lead.status || '');\n  if (alwaysActiveStatuses.has(status)) return true;\n  return status === 'reply_needs_human' && (\n    lead.next_workflow === '05 - Meeting Booking & Sales Handoff'\n    || lead.sales_handoff_status === 'processing'\n  );\n};\nconst active = targets.filter(isActive);\nconst waitingSelection = targets.filter((lead) => lead.meeting_status === 'slots_offered' || lead.status === 'awaiting_meeting_selection');\nconst booked = targets.filter((lead) => lead.meeting_status === 'booked' || lead.status === 'meeting_booked');\nconst handoffs = targets.filter((lead) => lead.sales_handoff_status === 'completed');\nconst review = targets.filter((lead) => lead.human_review_required === true || lead.status === 'meeting_needs_human' || lead.sales_handoff_status === 'failed');\nconst terminal = targets.filter((lead) => !isActive(lead));\nconst transitionReady = targets.length > 0 && active.length === 0 && terminal.length === targets.length;\nlet stage = targets.some(lead=>lead.status==='awaiting_booking') ? 'awaiting_calendly_booking' : 'sales_handoff_active';\nif (waitingSelection.length) stage = 'awaiting_meeting_selection';\nelse if (targets.some((lead) => ['meeting_requested','meeting_processing'].includes(String(lead.status || '')))) stage = 'meeting_booking_active';\nlet existing = job.result_summary;\nif (!existing || typeof existing !== 'object' || Array.isArray(existing)) existing = {};\nreturn [{ json: {\n  ...job, transition_ready: transitionReady, active_stage: stage,\n  workflow05_summary: {\n    matched_leads: leads.length, outreach_targets: targets.length, active_targets: active.length,\n    terminal_targets: terminal.length, waiting_for_slot_selection: waitingSelection.length,\n    meetings_booked: booked.length, sales_handoffs_completed: handoffs.length, human_review_queue: review.length\n  },\n  merged_result_summary: { ...existing,\n    workflow05_targets: targets.length, workflow05_active: active.length, workflow05_terminal: terminal.length,\n    workflow05_waiting_slot_selection: waitingSelection.length, meetings_booked: booked.length,\n    sales_handoffs_completed: handoffs.length, workflow05_human_review: review.length\n  }\n} }];"
      },
